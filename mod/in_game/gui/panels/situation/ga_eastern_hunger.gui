situation_panel = {
    blockoverride "situation_subheader_content" {}
    blockoverride "situation_panel_main_content" {
        text_single = {
            layoutpolicy_horizontal = expanding
            text = "ac_favor_current"
            tooltip = "ac_favor_explanation"
        }
        text_multi = {
            layoutpolicy_horizontal = expanding
            max_width = 400
            autoresize = yes
            text = "ga_ui_homeland_progress"
        }
        text_multi = {
            layoutpolicy_horizontal = expanding
            max_width = 400
            autoresize = yes
            text = "ga_ui_homeland_rules"
        }
        text_multi = {
            layoutpolicy_horizontal = expanding
            max_width = 400
            autoresize = yes
            text = "ga_ui_eastern_route"
        }
        text_multi = {
            layoutpolicy_horizontal = expanding
            max_width = 400
            autoresize = yes
            text = "ga_eastern_hunger_desc"
        }
        text_single = {
            layoutpolicy_horizontal = expanding
            text = "END_REQUIREMENTS"
        }
        TooltipRequirementsList = {
            textcontext = "[SituationView.GetActiveSituation.GetSituation.GetEndConditions]"
        }
    }
}
