local_variables={ "UnitState"=int }
behavioral_states={
 "Idle"={ timeline_layer={ timeline="Idle" } }
 "Attack"={ timeline_layer={ timeline="Attack" } }
 "Move"={ timeline_layer={ timeline="Move" } }
 "Retreat"={ timeline_layer={ timeline="Retreat" } }
 "Charge"={ timeline_layer={ timeline="Charge" } }
}
events={
 behavioral_state_transition={ name="Start" behavioral_state="Idle" transition_interval=0 }
 behavioral_state_transition={ name="Select Idle" trigger_interval_relative={ 0 1 } conditions={ "UnitState"="0" } behavioral_state="Idle" transition_interval=0.15 }
 behavioral_state_transition={ name="Select Attack" trigger_interval_relative={ 0 1 } conditions={ "UnitState"="1" } behavioral_state="Attack" transition_interval=0.15 }
 behavioral_state_transition={ name="Select Move" trigger_interval_relative={ 0 1 } conditions={ "UnitState"="2" } behavioral_state="Move" transition_interval=0.15 }
 behavioral_state_transition={ name="Select Retreat" trigger_interval_relative={ 0 1 } conditions={ "UnitState"="3" } behavioral_state="Retreat" transition_interval=0.15 }
 behavioral_state_transition={ name="Select Charge" trigger_interval_relative={ 0 1 } conditions={ "UnitState"="4" } behavioral_state="Charge" transition_interval=0.15 }
}
timelines={
 "Idle"={ events={ "Select Attack" "Select Move" "Select Retreat" "Select Charge" } boundary_behavior=loop starttime_offset=0 playback_rate=1 layer=0 animation="cm_goblin_Idle" duration_source=animation }
 "Attack"={ events={ "Select Idle" "Select Move" "Select Retreat" "Select Charge" } boundary_behavior=loop starttime_offset=0 playback_rate=1 layer=0 animation="cm_goblin_SwordSlash" duration_source=animation }
 "Move"={ events={ "Select Idle" "Select Attack" "Select Retreat" "Select Charge" } boundary_behavior=loop starttime_offset=0 playback_rate=1 layer=0 animation="cm_goblin_Walk" duration_source=animation }
 "Retreat"={ events={ "Select Idle" "Select Attack" "Select Move" "Select Charge" } boundary_behavior=loop starttime_offset=0 playback_rate=1 layer=0 animation="cm_goblin_Run" duration_source=animation }
 "Charge"={ events={ "Select Idle" "Select Attack" "Select Move" "Select Retreat" } boundary_behavior=loop starttime_offset=0 playback_rate=1 layer=0 animation="cm_goblin_Run" duration_source=animation }
}
starting_timeline={ on_enter={ "Start" } boundary_behavior=loop starttime_offset=0 playback_rate=1 layer=0 }
